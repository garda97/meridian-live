[Unit]
Description=Run the GMGN ban watcher every 30 minutes

[Timer]
# The watcher exits immediately unless tools/gmgn.js has recorded a ban, so a
# 30-minute cadence costs nothing during normal operation and only spends GMGN
# quota while a ban is actually active.
OnBootSec=5min
OnUnitActiveSec=30min
AccuracySec=1min
# Catch up after a reboot or a suspended host instead of silently skipping.
Persistent=true

[Install]
WantedBy=timers.target
